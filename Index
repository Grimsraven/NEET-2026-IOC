          <tr><td>He₂</td><td>4</td><td>0</td><td>—</td></tr>
          <tr><td>O₂</td><td>16</td><td>2</td><td>Para</td></tr>
          <tr><td>N₂</td><td>14</td><td>3</td><td>Dia</td></tr>
