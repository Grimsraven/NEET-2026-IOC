<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NEET 2026 – Inorganic Chemistry Master Notes</title>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Nunito:wght@400;600;700;800&family=Fira+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0f1e;
    --card: #111827;
    --card2: #0f172a;
    --border: #1e293b;
    --accent: #38bdf8;
    --accent2: #818cf8;
    --accent3: #34d399;
    --accent4: #fb923c;
    --accent5: #f472b6;
    --accent6: #facc15;
    --text: #e2e8f0;
    --muted: #94a3b8;
    --red: #f87171;
    --glow: 0 0 20px rgba(56,189,248,0.2);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Nunito', sans-serif;
    font-size: 14px;
    line-height: 1.6;
  }
  /* HEADER */
  .hero {
    background: linear-gradient(135deg, #0a0f1e 0%, #0f172a 40%, #162033 100%);
    border-bottom: 1px solid var(--border);
    padding: 36px 24px 28px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -60px; left: 50%; transform: translateX(-50%);
    width: 600px; height: 200px;
    background: radial-gradient(ellipse, rgba(56,189,248,0.15) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-badge {
    display: inline-block;
    background: rgba(56,189,248,0.1);
    border: 1px solid rgba(56,189,248,0.3);
    color: var(--accent);
    font-family: 'Rajdhani', sans-serif;
    font-size: 11px; font-weight: 600; letter-spacing: 3px;
    padding: 4px 14px; border-radius: 20px; margin-bottom: 12px;
    text-transform: uppercase;
  }
  .hero h1 {
    font-family: 'Rajdhani', sans-serif;
    font-size: 2.6em; font-weight: 700;
    background: linear-gradient(90deg, var(--accent), var(--accent2), var(--accent3));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 1px;
  }
  .hero-sub {
    color: var(--muted); font-size: 13px; margin-top: 6px;
    font-weight: 600; letter-spacing: 1px;
  }
  .stats-row {
    display: flex; justify-content: center; gap: 24px; margin-top: 18px; flex-wrap: wrap;
  }
  .stat {
    background: rgba(255,255,255,0.04); border: 1px solid var(--border);
    padding: 8px 18px; border-radius: 8px; text-align: center;
  }
  .stat-num { font-family: 'Rajdhani', sans-serif; font-size: 1.5em; font-weight: 700; color: var(--accent); }
  .stat-lbl { font-size: 10px; color: var(--muted); letter-spacing: 1px; text-transform: uppercase; }

  /* NAV */
  .toc {
    background: var(--card2);
    border-bottom: 1px solid var(--border);
    padding: 14px 20px;
    display: flex; flex-wrap: wrap; gap: 8px; justify-content: center;
  }
  .toc a {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 12px; border-radius: 6px;
    font-family: 'Rajdhani', sans-serif; font-weight: 600; font-size: 12px;
    letter-spacing: 0.5px; text-decoration: none;
    border: 1px solid var(--border);
    transition: all 0.2s;
  }
  .toc a:hover { transform: translateY(-1px); }
  .t1 { color: var(--accent); background: rgba(56,189,248,0.07); }
  .t1:hover { background: rgba(56,189,248,0.18); border-color: var(--accent); }
  .t2 { color: var(--accent2); background: rgba(129,140,248,0.07); }
  .t2:hover { background: rgba(129,140,248,0.18); border-color: var(--accent2); }
  .t3 { color: var(--accent3); background: rgba(52,211,153,0.07); }
  .t3:hover { background: rgba(52,211,153,0.18); border-color: var(--accent3); }
  .t4 { color: var(--accent4); background: rgba(251,146,60,0.07); }
  .t4:hover { background: rgba(251,146,60,0.18); border-color: var(--accent4); }
  .t5 { color: var(--accent5); background: rgba(244,114,182,0.07); }
  .t5:hover { background: rgba(244,114,182,0.18); border-color: var(--accent5); }
  .t6 { color: var(--accent6); background: rgba(250,204,21,0.07); }
  .t6:hover { background: rgba(250,204,21,0.18); border-color: var(--accent6); }

  /* MAIN LAYOUT */
  .container { max-width: 1100px; margin: 0 auto; padding: 24px 16px; }

  /* SECTION HEADERS */
  .sec-header {
    display: flex; align-items: center; gap: 14px;
    margin: 40px 0 20px; padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .sec-icon {
    width: 38px; height: 38px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; flex-shrink: 0;
  }
  .sec-title {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.6em; font-weight: 700; letter-spacing: 0.5px;
  }
  .sec-tag {
    margin-left: auto; font-size: 10px; letter-spacing: 2px;
    font-family: 'Rajdhani', sans-serif; font-weight: 600; padding: 3px 10px;
    border-radius: 4px; text-transform: uppercase;
  }

  /* CARDS */
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; }
  .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
  .card {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 12px; padding: 16px;
    position: relative; overflow: hidden;
  }
  .card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
  }
  .card-b1::before { background: linear-gradient(90deg, var(--accent), transparent); }
  .card-b2::before { background: linear-gradient(90deg, var(--accent2), transparent); }
  .card-b3::before { background: linear-gradient(90deg, var(--accent3), transparent); }
  .card-b4::before { background: linear-gradient(90deg, var(--accent4), transparent); }
  .card-b5::before { background: linear-gradient(90deg, var(--accent5), transparent); }
  .card-b6::before { background: linear-gradient(90deg, var(--accent6), transparent); }

  .card-title {
    font-family: 'Rajdhani', sans-serif; font-size: 1em; font-weight: 700;
    letter-spacing: 0.5px; margin-bottom: 10px;
    display: flex; align-items: center; gap: 8px;
  }
  ul.notes { list-style: none; padding: 0; }
  ul.notes li {
    padding: 4px 0 4px 16px; position: relative;
    color: var(--text); font-size: 13px; border-bottom: 1px solid rgba(255,255,255,0.03);
  }
  ul.notes li:last-child { border-bottom: none; }
  ul.notes li::before {
    content: '▸'; position: absolute; left: 0;
    color: var(--muted); font-size: 10px; top: 6px;
  }

  /* FORMULA BOXES */
  .formula {
    background: rgba(56,189,248,0.07); border: 1px solid rgba(56,189,248,0.2);
    border-radius: 8px; padding: 8px 12px; margin: 6px 0;
    font-family: 'Fira Mono', monospace; font-size: 12.5px;
    color: var(--accent);
  }
  .formula2 {
    background: rgba(129,140,248,0.07); border: 1px solid rgba(129,140,248,0.2);
    border-radius: 8px; padding: 8px 12px; margin: 6px 0;
    font-family: 'Fira Mono', monospace; font-size: 12.5px;
    color: var(--accent2);
  }
  .formula3 {
    background: rgba(52,211,153,0.07); border: 1px solid rgba(52,211,153,0.2);
    border-radius: 8px; padding: 8px 12px; margin: 6px 0;
    font-family: 'Fira Mono', monospace; font-size: 12.5px;
    color: var(--accent3);
  }

  /* HIGHLIGHT TAGS */
  .hl { display: inline-block; padding: 1px 7px; border-radius: 4px; font-size: 12px; font-weight: 700; margin: 1px; }
  .hl-b { background: rgba(56,189,248,0.15); color: var(--accent); }
  .hl-p { background: rgba(129,140,248,0.15); color: var(--accent2); }
  .hl-g { background: rgba(52,211,153,0.15); color: var(--accent3); }
  .hl-o { background: rgba(251,146,60,0.15); color: var(--accent4); }
  .hl-r { background: rgba(248,113,113,0.15); color: var(--red); }
  .hl-y { background: rgba(250,204,21,0.15); color: var(--accent6); }

  /* MEMORY AIDS */
  .memory-box {
    background: linear-gradient(135deg, rgba(251,146,60,0.08), rgba(244,114,182,0.08));
    border: 1px solid rgba(251,146,60,0.25); border-radius: 10px;
    padding: 12px 16px; margin: 10px 0;
  }
  .memory-box .mem-title {
    font-family: 'Rajdhani', sans-serif; font-size: 11px; font-weight: 700;
    letter-spacing: 2px; color: var(--accent4); text-transform: uppercase; margin-bottom: 6px;
  }
  .memory-box p { color: var(--text); font-size: 13px; }

  /* ALERT BOXES */
  .alert {
    border-radius: 8px; padding: 10px 14px; margin: 8px 0;
    font-size: 13px; display: flex; gap: 8px; align-items: flex-start;
  }
  .alert-icon { font-size: 14px; flex-shrink: 0; margin-top: 1px; }
  .alert-warn { background: rgba(250,204,21,0.08); border: 1px solid rgba(250,204,21,0.2); }
  .alert-warn .alert-icon { color: var(--accent6); }
  .alert-tip { background: rgba(52,211,153,0.08); border: 1px solid rgba(52,211,153,0.2); }
  .alert-tip .alert-icon { color: var(--accent3); }
  .alert-imp { background: rgba(248,113,113,0.08); border: 1px solid rgba(248,113,113,0.2); }
  .alert-imp .alert-icon { color: var(--red); }

  /* TABLES */
  .tbl-wrap { overflow-x: auto; margin: 8px 0; border-radius: 8px; }
  table {
    width: 100%; border-collapse: collapse;
    font-size: 12.5px;
  }
  th {
    background: rgba(56,189,248,0.1); color: var(--accent);
    font-family: 'Rajdhani', sans-serif; font-weight: 600;
    padding: 8px 10px; text-align: left; letter-spacing: 0.5px;
    border-bottom: 1px solid rgba(56,189,248,0.2);
  }
  td {
    padding: 7px 10px; border-bottom: 1px solid rgba(255,255,255,0.04);
    color: var(--text);
  }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: rgba(255,255,255,0.02); }

  /* ORDER CHAIN */
  .chain {
    display: flex; flex-wrap: wrap; align-items: center; gap: 6px;
    margin: 6px 0; font-family: 'Fira Mono', monospace; font-size: 12px;
  }
  .chain-item {
    padding: 3px 10px; border-radius: 4px;
    background: rgba(56,189,248,0.1); color: var(--accent);
    border: 1px solid rgba(56,189,248,0.2);
  }
  .chain-sep { color: var(--muted); font-size: 14px; font-weight: 700; }

  /* REACTION BOXES */
  .rxn {
    background: rgba(15,23,42,0.8); border: 1px solid var(--border);
    border-radius: 8px; padding: 10px 14px; margin: 6px 0;
    font-family: 'Fira Mono', monospace; font-size: 12px;
    color: var(--text); line-height: 1.7;
  }
  .rxn .arrow { color: var(--accent4); font-weight: bold; }
  .rxn .product { color: var(--accent3); }
  .rxn .cond { color: var(--muted); font-size: 10px; }

  /* TWO-COL */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media(max-width: 600px) { .two-col { grid-template-columns: 1fr; } }

  /* SPECTROCHEMICAL SERIES */
  .spec-series {
    background: var(--card2); border: 1px solid var(--border);
    border-radius: 10px; padding: 14px;
    font-family: 'Fira Mono', monospace; font-size: 11px;
    overflow-x: auto; white-space: nowrap;
  }
  .spec-weak { color: var(--red); }
  .spec-strong { color: var(--accent3); }

  /* SALT ANALYSIS FLOWCHARTS */
  .flow-group {
    background: var(--card2); border: 1px solid var(--border);
    border-radius: 10px; padding: 14px; margin-bottom: 12px;
  }
  .flow-group-title {
    font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 13px;
    margin-bottom: 10px; padding-bottom: 6px;
    border-bottom: 1px solid var(--border);
  }
  .flow-row {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,0.03);
    font-size: 12.5px;
  }
  .flow-row:last-child { border-bottom: none; }
  .flow-ion { font-family: 'Fira Mono', monospace; color: var(--accent); min-width: 60px; font-weight: 600; padding-top: 2px; }
  .flow-reagent { color: var(--accent4); font-family: 'Fira Mono', monospace; min-width: 140px; font-size: 11.5px; }
  .flow-obs { color: var(--accent3); }

  /* STICKY SUB-HEADER */
  .sticky-note {
    position: sticky; top: 0; z-index: 10;
    background: rgba(10,15,30,0.95); backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
    padding: 8px 20px; font-size: 11px; color: var(--muted);
    font-family: 'Rajdhani', sans-serif; font-weight: 600; letter-spacing: 1px;
    text-align: center; text-transform: uppercase;
  }

  /* HYDRIDES / TREND TABLES */
  .trend-card {
    background: var(--card2); border: 1px solid var(--border);
    border-radius: 10px; padding: 14px; margin-bottom: 12px;
  }
  .trend-title {
    font-family: 'Rajdhani', sans-serif; font-weight: 700;
    font-size: 13px; color: var(--accent2); margin-bottom: 10px;
    letter-spacing: 0.5px;
  }

  /* PRINT */
  @media print {
    body { background: white; color: black; }
    .card { background: #f8f8f8; border: 1px solid #ddd; }
    .toc { display: none; }
    .sticky-note { display: none; }
  }
</style>
